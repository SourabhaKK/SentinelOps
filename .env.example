# Phase 0 Prerequisites — Copy this to .env and fill in your keys

# Daytona sandbox API key
# Get from: https://daytona.io → Dashboard → API Keys
DAYTONA_API_KEY=your_daytona_api_key_here

# Gemini 2.0 Flash API key (primary model)
# Get from: https://ai.google.dev/ → Get API Key
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (fallback model)
# Get from: https://console.groq.com/ → API Keys
GROQ_API_KEY=your_groq_api_key_here

# TrueForge model configuration (optional, will be set during Phase 1.3)
TRUEFORGE_PRIMARY_MODEL=gemini-2.0-flash
TRUEFORGE_FALLBACK_MODEL=groq

# GitHub token (optional, for private repo access if needed)
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=your_github_token_here
